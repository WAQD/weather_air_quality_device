<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Glossy Background (Expanded upwards to cover ~80% of height) -->
    <!-- Note: using FrameLayout instead of View because generic View is not supported in App Widgets (RemoteViews) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_margin="4dp"
        android:background="@drawable/widget_glossy_bg" />

    <!-- Content layout preserving original proportions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="@dimen/widget_padding">

        <!-- Top Section: HTC Style Clock Panels -->
        <LinearLayout
            android:id="@+id/clock_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.2"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/widget_clock_margin">

                <TextClock
                    android:id="@+id/widget_clock_hour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/clock_panel"
                    android:gravity="center"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:textColor="#222222"
                    android:textSize="110sp"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textStyle="normal"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="4" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/widget_clock_margin">

                <TextClock
                    android:id="@+id/widget_clock_minute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/clock_panel"
                    android:gravity="center"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:textColor="#222222"
                    android:textSize="110sp"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textStyle="normal"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Section: Weather Info -->
        <RelativeLayout
            android:id="@+id/weather_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <!-- Left: Location & Condition -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alafaya"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:shadowColor="#CC000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloudy"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp" />
                    
                <!-- <TextView
                    android:id="@+id/widget_update_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Updated: \-\-:\-\-"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" /> -->
            </LinearLayout>

            <!-- Right: Temps -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="58°"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/widget_temp_text_size"
                    android:shadowColor="#CC000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/widget_daily_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="62° / 50°"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Center: Icon -->
            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="-25dp"
                android:src="@android:drawable/ic_menu_report_image" />
        </RelativeLayout>

        <!-- Extended Forecast Section -->
        <LinearLayout
            android:id="@+id/forecast_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:baselineAligned="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <!-- Day 1 -->
            <LinearLayout
                android:id="@+id/forecast_cell_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/forecast_day_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <ImageView
                        android:id="@+id/forecast_icon_1"
                        android:layout_width="32dp"
                        android:layout_height="32dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/forecast_temp_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="--°\n--°"
                    android:textColor="#DDFFFFFF"
                    android:gravity="center"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Day 2 -->
            <LinearLayout
                android:id="@+id/forecast_cell_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/forecast_day_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tue"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <ImageView
                        android:id="@+id/forecast_icon_2"
                        android:layout_width="32dp"
                        android:layout_height="32dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/forecast_temp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="--°\n--°"
                    android:textColor="#DDFFFFFF"
                    android:gravity="center"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Day 3 -->
            <LinearLayout
                android:id="@+id/forecast_cell_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/forecast_day_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wed"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <ImageView
                        android:id="@+id/forecast_icon_3"
                        android:layout_width="32dp"
                        android:layout_height="32dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/forecast_temp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="--°\n--°"
                    android:textColor="#DDFFFFFF"
                    android:gravity="center"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>