{
  "name": "waqd_website_frontend",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/optimize-images.js && capacitor-assets generate",
    "build:only": "vite build",
    "release:android": "vite build && rm -rf dist/static && npx cap sync android && (cd android && ./gradlew assembleRelease)",
    "optimize-images": "node scripts/optimize-images.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/preferences": "^8.0.1",
    "@openmeteo/weather-map-layer": "^0.0.20",
    "capacitor-native-settings": "^8.2.0",
    "chart.js": "^4.5.1",
    "daisyui": "^5.7.17",
    "highcharts": "^13.0.0",
    "maplibre-gl": "^6.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.5",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.50.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "tar": "^7.5.21"
