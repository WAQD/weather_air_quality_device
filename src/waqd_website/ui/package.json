{
  "name": "waqd_website_frontend",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/optimize-images.js && capacitor-assets generate",
    "build:only": "vite build",
    "release:android": "vite build && rm -rf dist/static && npx cap sync android && capacitor-assets generate && (cd android && ./gradlew assembleRelease)",
