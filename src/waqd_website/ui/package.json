    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.12",
