    "@openmeteo/weather-map-layer": "^0.3.0",
    "capacitor-native-settings": "^8.2.0",
    "chart.js": "^4.6.1",
    "daisyui": "^5.7.50",
    "highcharts": "^13.1.1",
    "maplibre-gl": "^6.15.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
