# Base URL for the WAQD backend API.
# Used by: vite dev proxy, Capacitor server.url, web fallback, and Android BuildConfig.
# Local dev: http://192.168.178.57:8000  /  Production: https://waqd.de
VITE_WAQD_BASE_URL=https://waqd.de

# Enable the signup / create-account flow. Disabled by default (closed beta).
# Set to "true" to show the signup button on the login screen.
VITE_ENABLE_SIGNUP=false
